{
  "policies": {},
  "rules": [
    {
      "chain": "INPUT",
      "name": "Allow web",
      "action": "allow",
      "protocol": "tcp",
      "source": "any",
      "destination": "10.0.0.10",
      "dport": "80,443",
      "log": false
    },
    {
      "chain": "INPUT",
      "name": "Allow SSH from admin net",
      "action": "allow",
      "protocol": "tcp",
      "source": "192.168.50.0/24",
      "destination": "10.0.0.0/24",
      "dport": "22"
    },
    {
      "chain": "INPUT",
      "name": "RDP from anywhere",
      "action": "allow",
      "protocol": "tcp",
      "source": "any",
      "destination": "10.0.0.20",
      "dport": "3389"
    },
    {
      "chain": "INPUT",
      "name": "Telnet legacy",
      "action": "allow",
      "protocol": "tcp",
      "source": "any",
      "destination": "10.0.0.30",
      "dport": "23"
    },
    {
      "chain": "INPUT",
      "name": "Allow all from LAN",
      "action": "allow",
      "protocol": "any",
      "source": "192.168.0.0/16",
      "destination": "any",
      "dport": "any"
    },
    {
      "chain": "INPUT",
      "name": "Block guest SSH",
      "action": "deny",
      "protocol": "tcp",
      "source": "192.168.50.0/24",
      "destination": "10.0.0.0/24",
      "dport": "22"
    },
    {
      "chain": "INPUT",
      "name": "Allow HTTPS (dup)",
      "action": "allow",
      "protocol": "tcp",
      "source": "any",
      "destination": "10.0.0.10",
      "dport": "443"
    },
    {
      "chain": "INPUT",
      "name": "Open high ports",
      "action": "allow",
      "protocol": "tcp",
      "source": "any",
      "destination": "10.0.0.40",
      "dport": "1024-65535"
    },
    {
      "chain": "INPUT",
      "name": "Old rule",
      "action": "allow",
      "protocol": "tcp",
      "source": "172.16.0.0/12",
      "destination": "10.0.0.50",
      "dport": "8080",
      "enabled": false
    },
    {
      "chain": "FORWARD",
      "name": "Allow everything",
      "action": "allow",
      "protocol": "any",
      "source": "any",
      "destination": "any",
      "dport": "any"
    },
    {
      "chain": "FORWARD",
      "name": "Block SMB",
      "action": "deny",
      "protocol": "tcp",
      "source": "any",
      "destination": "any",
      "dport": "445"
    }
  ]
}